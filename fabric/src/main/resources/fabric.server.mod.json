{
	"schemaVersion": 1,
	"id": "cfcmusic",
	"version": "${version}",
	"name": "CFCMusic Server",
	"description": "CFC dedicated server music queue coordinator for Minecraft.",
	"authors": [
		"KoishiMoe"
	],
	"contact": {
		"homepage": "https://github.com/lolicode-org/CFCMusic",
		"sources": "https://github.com/lolicode-org/CFCMusic",
		"issues": "https://github.com/lolicode-org/CFCMusic/issues"
	},
	"license": "AGPL-3.0-or-later",
	"icon": "assets/cfcmusic/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			{
				"value": "org.lolicode.moemusic.MoeMusic",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"cfcmusic.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.11.0",
		"badpackets": ">=0.12.0"
	},
	"suggests": {
		"fabric-permissions-api-v0": ">=0.7.0"
	}
}
