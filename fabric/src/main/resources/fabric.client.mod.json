{
	"schemaVersion": 1,
	"id": "cfcmusic",
	"version": "${version}",
	"name": "CFCMusic Client",
	"description": "ColorFulCraft特供版，基于moemusic开发。CFC dedicated client music player for Minecraft.",
	"authors": [
		"KoishiMoe"
	],
	"contact": {
		"homepage": "https://github.com/lolicode-org/CFCMusic",
		"sources": "https://github.com/lolicode-org/CFCMusic",
		"issues": "https://github.com/lolicode-org/CFCMusic/issues"
	},
	"license": "AGPL-3.0-or-later",
	"icon": "assets/cfcmusic/icon.png",
	"custom": {
		"cfcmusic:edition": "ColorFulCraft特供版，基于moemusic开发"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "org.lolicode.moemusic.client.MoeMusicClient",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			"org.lolicode.moemusic.client.MoeMusicModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "cfcmusic.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.11.0",
		"badpackets": ">=0.12.0"
	},
	"suggests": {
		"cloth-config": ">=26.2",
		"modmenu": ">19.999"
	}
}
